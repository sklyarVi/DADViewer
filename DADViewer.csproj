    <ApplicationDefinition Include="DADViewer/App.xaml" />
    <Compile Include="DADViewer/App.xaml.cs" />
    <ProjectReference Include="DADViewer.Presentation/DADViewer.Presentation.csproj" />
    <ProjectReference Include="DADViewer.Infrastructure/DADViewer.Infrastructure.csproj" />
  </ItemGroup>
</Project>
