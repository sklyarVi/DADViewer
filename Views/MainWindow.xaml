<Window x:Class="DADViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:views="clr-namespace:DADViewer.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="DAD Viewer"
        Height="920"
        Width="1320"
        MinHeight="760"
        MinWidth="1100"
        ResizeMode="CanResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="#EEF2F7"
        FontFamily="Segoe UI Variable Text">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#F7FAFD"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#1F6FEB"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D7E0EA"/>
        <SolidColorBrush x:Key="TextMainBrush" Color="#1D2A39"/>
        <SolidColorBrush x:Key="TextSubBrush" Color="#5A6B7E"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F2F6FB"/>
                    <Setter Property="BorderBrush" Value="#C8D7E8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E8F0FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="CloseTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="BorderBrush" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Foreground" Value="{StaticResource TextSubBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="DAD Viewer"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSubBrush}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Content="_"
                            Click="MinimizeButton_Click"/>
                    <Button x:Name="MaxRestoreButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Content="□"
                            Click="MaximizeRestoreButton_Click"/>
                    <Button Style="{StaticResource CloseTitleBarButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Content="X"
                            Click="CloseWindowButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,12,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Open DAD" Click="OpenFileButton_Click"/>
                        <Button Content="Export 2D PNG" Click="Export2DImage_Click"/>
                        <Button Content="Export Chrom CSV" Click="ExportChromatogramCsv_Click"/>
                        <Button Content="Export Spectrum CSV" Click="ExportSpectrumCsv_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="SettingsPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="Colors"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="{StaticResource TextSubBrush}"/>
                        <Slider x:Name="ColorStepsSlider"
                                Minimum="2"
                                Maximum="64"
                                Value="16"
                                Width="150"
                                ValueChanged="ColorStepsSlider_ValueChanged"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="Palette"
                                   VerticalAlignment="Center"
                                   Margin="14,0,8,0"
                                   Foreground="{StaticResource TextSubBrush}"/>
                        <ComboBox x:Name="ColorSchemeComboBox"
                                  SelectionChanged="ColorSchemeComboBox_SelectionChanged"
                                  Width="150"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="Blue-Red" IsSelected="True"/>
                            <ComboBoxItem Content="Viridis"/>
                            <ComboBoxItem Content="Jet"/>
                            <ComboBoxItem Content="Hot"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="12">
                <TabControl x:Name="MainTabControl">
                    <TabItem Header="2D Analysis">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="5*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="2.2*"/>
                                    <RowDefinition Height="2.2*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="White"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="8"
                                        Margin="0,0,0,10">
                                    <views:DAD2DView x:Name="Dad2DViewControl" Background="White"/>
                                </Border>

                                <Border Grid.Row="1"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="10"
                                        Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal"
                                                x:Name="WaveSlider"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="Wavelength index"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Foreground="{StaticResource TextSubBrush}"/>
                                        <Slider x:Name="WavelengthSlider"
                                                Minimum="0"
                                                Maximum="105"
                                                Value="50"
                                                Width="280"
                                                ValueChanged="WavelengthSlider_ValueChanged"
                                                VerticalAlignment="Center"/>
                                        <TextBlock x:Name="WavelengthValueText"
                                                   Text="50"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2"
                                        Background="White"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="8"
                                        Margin="0,0,0,10">
                                    <views:ChromatogramView x:Name="ChromatogramViewControl" Background="White"/>
                                </Border>

                                <Border Grid.Row="3"
                                        Background="White"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="8">
                                    <views:SpectrumView x:Name="SpectrumViewControl" Background="White"/>
                                </Border>
                            </Grid>

                            <Border Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Color Scale"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>
                                    <TextBlock x:Name="LegendMaxValueText"
                                               Text="Max"
                                               HorizontalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                    <Border Width="28"
                                            Height="240"
                                            BorderBrush="#BFCBDD"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center"
                                            Margin="0,8,0,8"
                                            CornerRadius="4">
                                        <Image x:Name="ColorLegendImage" Stretch="Fill"/>
                                    </Border>
                                    <TextBlock x:Name="LegendMinValueText"
                                               Text="Min"
                                               HorizontalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                    <Separator Margin="0,14,0,14"/>
                                    <TextBlock Text="Tips"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="- Click on 2D map to sync all views"
                                               Foreground="{StaticResource TextSubBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="- Click chromatogram to move by time"
                                               Foreground="{StaticResource TextSubBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="- Click spectrum to move by wavelength"
                                               Foreground="{StaticResource TextSubBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="3D Surface">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3.8*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="White"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8"
                                    Margin="0,0,10,0">
                                <views:DAD3DView x:Name="DAD3DViewControl" />
                            </Border>

                            <Border Grid.Column="1"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Data Summary"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,12"/>
                                    <TextBlock x:Name="MinTimeText" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="MaxTimeText" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="MinWaveText" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="MaxWaveText" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="MinIntensityText" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="MaxIntensityText" Margin="0,0,0,6"/>
                                    <Separator Margin="0,12,0,12"/>
                                    <TextBlock Text="3D Controls"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="- Drag with left mouse button to rotate"
                                               Foreground="{StaticResource TextSubBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="- Mouse wheel to zoom"
                                               Foreground="{StaticResource TextSubBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Row="2"
                    Background="#F8FBFF"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10,8"
                    Margin="0,14,0,0">
                <TextBlock x:Name="StatusInfoText"
                           Foreground="{StaticResource TextSubBrush}"
                           Text="No data loaded."/>
            </Border>
        </Grid>
    </Grid>
</Window>
